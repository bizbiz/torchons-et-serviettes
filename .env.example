# PostgreSQL
POSTGRES_USER=tsapp
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=torchons_serviettes
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://tsapp:CHANGE_ME@localhost:5435/torchons_serviettes
DATABASE_URL_SYNC=postgresql://tsapp:CHANGE_ME@localhost:5435/torchons_serviettes

# Auth — generer un secret aleatoire fort, par exemple via :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME

# Tailscale — mapping JSON {"ip":"username"} pour l'auto-login zero-config.
# Vide par defaut, l'auto-login est alors desactive et tout le monde passe par le login manuel.
TAILSCALE_MAP={}

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002

# Version gate (cf. docs/version-gate.fr.md et backend/app/utils/version_gate.py).
# En dessous de ce versionCode Android, les routes de donnees repondent 426 et
# l'app se bloque sur un ecran de mise a jour.
#
# 0 = desactive, et c'est le defaut voulu : deployer le code ne bloque personne.
# Lever ce seuil verrouille d'un coup TOUS les telephones en dessous, et les APK
# sont sideloades — il n'y a pas de store pour pousser le correctif. Renseigner
# MIN_APP_DOWNLOAD_URL AVANT de lever le seuil, jamais apres.
MIN_APP_VERSION_CODE=0
MIN_APP_DOWNLOAD_URL=
