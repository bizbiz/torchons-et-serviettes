    <string name="foyer_bonus_threshold_normal_desc">%% du cycle de retard pour déclencher le bonus sur les tâches Normal.</string>
    <string name="foyer_bonus_threshold_souple_desc">%% du cycle de retard pour déclencher le bonus sur les tâches Souple.</string>
