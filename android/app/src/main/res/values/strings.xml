    <string name="foyer_bonus_pct_value_format">+%1$d%%</string>
    <string name="foyer_bonus_pct_desc">Multiplicateur appliqué quand une tâche est en retard au-delà du seuil. +50%% = touche 1.5x les points.</string>
    <string name="foyer_bonus_threshold_strict">Seuil bonus (Strict)</string>
