    <!-- (14) Tolérance fair-share -->
    <string name="foyer_fair_share_title_format">Tolérance fair-share&#160;: %1$d%%</string>
    <string name="foyer_fair_share_tooltip_title">Tolérance fair-share</string>
    <string name="foyer_fair_share_tooltip_description">L\'app te dit «&#160;tu as fait plus que ta part&#160;» quand tu as fait au moins X%% de plus que ton ratio cible. À 30%% (défaut) avec un ratio 50/50, l\'app te félicite quand tu as fait 65%% du boulot ou plus. À 0%%, l\'app te félicite dès que tu dépasses ton ratio. À 100%%, jamais (sauf si tu fais tout).</string>

