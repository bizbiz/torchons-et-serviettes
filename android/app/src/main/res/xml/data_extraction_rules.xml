<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for API 31+. `full_backup_content.xml` carries the same
  intent for API 26-30 — declaring only one of the two silently leaves half
  the fleet on the default, so they must be edited together.

  Everything is backed up EXCEPT `device_identity`. That single exclusion is
  what makes two handsets distinguishable: a phone restored onto new hardware
  finds no identity, mints a fresh one, and becomes its own row server-side
  while the old handset keeps its own — so either can be revoked without the
  other. The session token, preferences, home WiFi and Room database keep
  being restored, so the transfer stays invisible to the user.

  Measured 2026-09-02: a full uninstall/reinstall restored the session with
  no sign-in, which is exactly the comfort this preserves.

  Rationale and arbitrations: docs/appareils.fr.md
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/device_identity.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/device_identity.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
