# Python
__pycache__/
*.pyc
*.pyo
backend/.venv/
*.egg-info/

# Environment
.env
.env.*
!.env.example
!.env.prod.example

# Postgres dumps (cutover, dry-run, backups) — peuvent contenir des
# pseudos d'user et l'historique complet du foyer dogfood. Ne JAMAIS
# committer.
*.dump
ts_dump_*

# IDE
.idea/
.vscode/
*.swp
.claude/

# Session
session_resume.md

# OS
.DS_Store
Thumbs.db

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
# Clés de signature — JAMAIS dans le repo (keystore vit hors repo + ici en filet)
*.jks
*.keystore

# Assets Play exportés (captures/feature graphic) : atelier local, peuvent
# contenir des données — uploadés direct dans la Play Console, pas versionnés.
docs/play-assets/*.png
docs/play-assets/*.jpg
docs/play-assets/*.jpeg

# Firebase
backend/firebase-key.json
android/app/google-services.json

# Docker
ts_pgdata/

# Seeds personnels : bootstrap dogfood, imports HA, fixtures liees a
# un foyer reel. Ne jamais commit la data d'un foyer particulier.
backend/seeds/personal/

# Base Room rapatriee du device pour debug (donnees reelles, jamais commitee)
.devdb/

# Captures Play Store rapatriees du device (assets, hors repo)
.captures/
