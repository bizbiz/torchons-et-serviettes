# Python
__pycache__/
*.pyc
*.pyo
backend/.venv/
*.egg-info/

# Environment
.env
.env.*
!.env.example
!.env.prod.example

# Postgres dumps (cutover, dry-run, backups) — may contain user pseudos
# and the full history of a real household. NEVER commit.
*.dump
ts_dump_*

# IDE
.idea/
.vscode/
*.swp
.claude/

# Session
session_resume.md

# OS
.DS_Store
Thumbs.db

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
# Signing keys — NEVER in the repo (keystore lives outside the repo; this is a safety net)
*.jks
*.keystore

# Local ops / personal: deployment runbooks, store listing pack,
# point-in-time audits, internal design docs, snapshots, personal
# utilities. Not relevant to external contributors — maintainer-local.
local-ops/

# Firebase
backend/firebase-key.json
android/app/google-services.json
# Admin SDK service-account keys downloaded from the console — NEVER in the repo
*-firebase-adminsdk-*.json

# Docker
ts_pgdata/

# Personal seeds: dogfood bootstrap, HA imports, fixtures tied to a real
# household. Never commit data from an actual household.
backend/seeds/personal/

# Room database pulled from a device for debugging (real data, never committed)
.devdb/

# Play Store screenshots pulled from a device (assets, out of repo)
.captures/

# Local AI assistant config — kept on disk for local development sessions
/CLAUDE.md
