# Template env PROD — copier en .env.prod sur le serveur et remplir.
# .env.prod est gitignored (.gitignore couvre .env / .env.*). NE JAMAIS commit.
#
#   cp .env.prod.example .env.prod  &&  $EDITOR .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# --- PostgreSQL ---
POSTGRES_USER=tsapp
POSTGRES_PASSWORD=CHANGE_ME_strong_random
POSTGRES_DB=torchons_serviettes
# Port host (bind 127.0.0.1 only, cf. compose) — utile pour le cutover.
POSTGRES_PORT=5435

# --- App (lu par app/config.py via env vars) ---
# NB: docker-compose.prod.yml override DATABASE_URL* pour pointer sur `db:5432`
# dans le reseau compose. Ces lignes servent de doc / fallback.
DATABASE_URL=postgresql+asyncpg://tsapp:CHANGE_ME_strong_random@db:5432/torchons_serviettes
DATABASE_URL_SYNC=postgresql://tsapp:CHANGE_ME_strong_random@db:5432/torchons_serviettes

# Secret JWT — generer : python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME_generate_with_secrets_token_urlsafe_32

# Tailscale auto-login : DESACTIVE en prod publique (mapping vide).
# L'app publique (flavor `prod`, BuildConfig.TAILSCALE_AUTOLOGIN=false) ne
# l'appelle pas ; on garde le mapping vide cote backend par securite.
TAILSCALE_MAP={}

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002

# --- Caddy ACME (Let's Encrypt) ---
# Email de contact pour les notifications de certificat Let's Encrypt.
ACME_EMAIL=contact@torchonsetserviettes.app
